{
  "name": "migpie-remote",
  "version": "0.3.0",
  "description": "Magpie SSH connection manager with c2s (-L) and s2c (-R) TCP forwarding tools",
  "repository": { "type": "git", "url": "git+https://github.com/zhaoyi2018/migpie-remote.git" },
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./server": "./index.mjs"
  },
  "files": ["index.mjs", "src/", "page/", "!page/.runtime/", "README.md", "docs/", "examples/", "LICENSE"],
  "magpie": {
    "page": {
      "title": "SSH connections",
      "titles": { "zh": "SSH 连接", "zh-TW": "SSH 連線" },
      "file": "page/index.html",
      "icon": "page/icon.svg"
    }
  },
  "keywords": ["magpie-plugin", "opencode", "opencode-plugin", "ssh", "tools", "port-forwarding"],
  "engines": { "node": ">=22" },
  "scripts": {
    "icons": "node scripts/generate-icon.mjs",
    "test": "node --test --test-concurrency=1",
    "test:host": "node scripts/host-smoke.mjs",
    "check": "node scripts/check.mjs",
    "prepack": "npm run check && npm test"
  },
  "dependencies": { "ssh2": "1.17.0" },
  "license": "MIT"
}
